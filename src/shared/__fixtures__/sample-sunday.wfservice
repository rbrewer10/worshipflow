      "type": "song",
      "ref_id": 1,
      "payload": {},
      "title": "Amazing Grace",
      "notes": null,
      "style": null,
      "zoneRouting": null,
      "track": "main",
      "song": {
        "id": 1,
        "title": "Amazing Grace",
        "author": "John Newton",
        "ccli": "22025",
        "copyright": "Public Domain",
        "publisher": null,
        "background": null,
        "arrangement": null,
        "fontScale": null,
        "linesPerSlide": null,
        "bgMotion": null,
        "textColor": null,
        "font": null,
        "blurBehindText": false,
        "sections": [
          {
            "id": 1,
            "kind": "verse",
            "label": "Verse 1",
            "ordinal": 0,
            "lyrics": "Amazing grace, how sweet the sound\nThat saved a wretch like me\nI once was lost, but now am found\nWas blind, but now I see"
          },
          {
            "id": 2,
            "kind": "verse",
            "label": "Verse 2",
            "ordinal": 1,
            "lyrics": "'Twas grace that taught my heart to fear\nAnd grace my fears relieved\nHow precious did that grace appear\nThe hour I first believed"
          },
          {
            "id": 3,
            "kind": "verse",
            "label": "Verse 3",
            "ordinal": 2,
            "lyrics": "When we've been there ten thousand years\nBright shining as the sun\nWe've no less days to sing God's praise\nThan when we first begun"
          }
        ]
      }
    },
    {
      "id": 6,
      "ordinal": 5,
      "type": "song",
      "ref_id": 2,
      "payload": {},
      "title": "Come Thou Fount of Every Blessing",
      "notes": null,
      "style": null,
      "zoneRouting": null,
      "track": "main",
      "song": {
        "id": 2,
        "title": "Come Thou Fount of Every Blessing",
        "author": "Robert Robinson",
        "ccli": null,
        "copyright": "Public Domain",
        "publisher": null,
        "background": null,
        "arrangement": null,
        "fontScale": null,
        "linesPerSlide": null,
        "bgMotion": null,
        "textColor": null,
        "font": null,
        "blurBehindText": false,
        "sections": [
          {
            "id": 4,
            "kind": "verse",
            "label": "Verse 1",
            "ordinal": 0,
            "lyrics": "Come, Thou Fount of every blessing\nTune my heart to sing Thy grace\nStreams of mercy, never ceasing\nCall for songs of loudest praise"
          },
          {
            "id": 5,
            "kind": "verse",
            "label": "Verse 2",
            "ordinal": 1,
            "lyrics": "Here I raise my Ebenezer\nHither by Thy help I've come\nAnd I hope, by Thy good pleasure\nSafely to arrive at home"
          },
          {
            "id": 6,
            "kind": "verse",
            "label": "Verse 3",
            "ordinal": 2,
            "lyrics": "Prone to wander, Lord, I feel it\nProne to leave the God I love\nHere's my heart, O take and seal it\nSeal it for Thy courts above"
          }
        ]
      }
    },
